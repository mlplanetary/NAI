{
  "manifest_version": 3,
  "name": "NAI – Say nay to AI posts",
  "short_name": "NAI",
  "version": "1.1.0",
  "description": "Hides LinkedIn posts about AI. Nay to the AI garbage.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
